{
  "name": "rum-backend-service",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --exec \"node --import dd-trace/register.js\" src/server.js",
    "start": "node --import dd-trace/register.js src/server.js",
    "test": "node --test",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
